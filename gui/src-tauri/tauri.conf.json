{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Serial MCP Console",
  "version": "0.1.0",
  "identifier": "dev.serial-mcp.console",
  "build": {
    "beforeDevCommand": "npm run prepare:sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Serial MCP Console",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "fragmentPaths": [
          "wix/path.wxs"
        ],
        "componentRefs": [
          "AddInstallDirToPath"
        ]
      }
    },
    "externalBin": [
      "binaries/serial-mcp-server"
    ],
    "resources": {
      "../USAGE.md": "USAGE.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Observe and control serial devices with real-time MCP activity mirroring"
  }
}
